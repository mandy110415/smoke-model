FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/root/.cache/huggingface

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgomp1 \
    libglib2.0-0 \
    libjpeg62-turbo \
    libpng16-16 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.train.txt .

# IMPORTANT:
# Install torch + torchvision from the SAME default PyPI source.
# This avoids the CPU-wheel torchvision::nms registration problem
# seen with some CPU-only wheel combinations.
RUN python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install \
        torch==2.5.1 \
        torchvision==0.20.1 && \
    python -m pip install -r requirements.train.txt && \
    python - <<'PY'
import torch
import torchvision
print("torch:", torch.__version__)
print("torchvision:", torchvision.__version__)
print("cuda available:", torch.cuda.is_available())
from transformers import AutoModel, AutoProcessor
print("transformers AutoModel/AutoProcessor import: OK")
PY

COPY train_siglip2_docker.py /app/train_siglip2.py
COPY evaluate_siglip2_docker.py /app/evaluate_siglip2.py

CMD ["python", "/app/train_siglip2.py"]
